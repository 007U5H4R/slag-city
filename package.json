{
  "name": "slag-city",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fonts:build": "tsx tools/fonts/build-retro-font.ts",
    "art:atlas": "tsx tools/art/build-atlas.ts",
    "e2e": "PLAYWRIGHT_BROWSERS_PATH='/Volumes/E Drive/Dev/.caches/ms-playwright' TMPDIR='/Volumes/E Drive/Dev/.scratch/tmp' playwright test",
    "e2e:prod": "BASE_URL=$PROD_URL npm run e2e -- --project=chromium",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "mixpanel-browser": "^2.83.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@napi-rs/canvas": "^1.0.8",
    "@playwright/test": "^1.63.0",
    "@types/mixpanel-browser": "^2.60.0",
    "@types/node": "^26.4.1",
    "eslint": "^9.39.5",
    "eslint-formatter-compact": "^9.0.1",
    "globals": "^17.12.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
